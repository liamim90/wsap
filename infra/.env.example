# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL + pgvector (메타데이터, 사용자 정보, 세션 데이터)
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# PostgreSQL Connection Pool
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600

# =============================================================================
# QDRANT VECTOR DATABASE CONFIGURATION  
# =============================================================================

# Qdrant Connection
QDRANT_URL=http://qdrant:6333
QDRANT_HOST=
QDRANT_PORT=
QDRANT_API_KEY=your-qdrant-api-key-here

# RAG Collections (3개)
QDRANT_COLLECTION_RAG_DOCUMENTS=rag_documents
QDRANT_COLLECTION_RAG_CHUNKS=rag_chunks  
QDRANT_COLLECTION_RAG_VECTORS=rag_vectors

# Memory Collections (2개)
QDRANT_COLLECTION_MEM_SUMMARY=mem_summary
QDRANT_COLLECTION_MEM_VECTORS=mem_vectors

# Session/Metadata Collection (1개)
QDRANT_COLLECTION_SESSION_META=session_meta

# Qdrant Collection Settings
QDRANT_VECTOR_SIZE=1024
QDRANT_DISTANCE_METRIC=Cosine
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=256
QDRANT_HNSW_EF_RUNTIME=128

# =============================================================================
# REDIS CONFIGURATION (캐싱, 세션, Celery)
# =============================================================================

REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB_CACHE=0
REDIS_DB_SESSION=1
REDIS_DB_CELERY=2

# =============================================================================
# SECURITY & AUTHENTICATION
# =============================================================================

# JWT Settings
SECRET_KEY=your-jwt-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# EXTERNAL API KEYS (Secrets Manager에서 관리)
# =============================================================================

# LLM APIs
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_AI_API_KEY=your-google-ai-api-key-here

# Embedding APIs  
VOYAGE_API_KEY=your-voyage-api-key-here
COHERE_API_KEY=your-cohere-api-key-here

# Secrets Manager (Production)
AWS_SECRETS_MANAGER_REGION=ap-northeast-2
AWS_SECRETS_MANAGER_SECRET_NAME=wsap/api-keys
VAULT_URL=http://localhost:8200
VAULT_TOKEN=your-vault-token

# =============================================================================
# RAG & CHUNKING CONFIGURATION
# =============================================================================

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_FILE_TYPES=["pdf", "docx", "txt", "md", "html", "csv", "xlsx", "pptx"]
UPLOAD_PATH=./uploads
PROCESSED_PATH=./processed

# Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHUNK_SEPARATORS=["\n\n", "\n", ".", "!", "?", ";", ":", " "]

# RAG Search Settings
RAG_TOP_K=10
RAG_SCORE_THRESHOLD=0.7
RAG_RERANK_TOP_K=5
RAG_MAX_CONTEXT_LENGTH=4000

# =============================================================================
# MEMORY & CONVERSATION SETTINGS
# =============================================================================

# Conversation Memory
MEM_SUMMARY_UPDATE_INTERVAL=10  # 10개 메시지마다 요약 업데이트
MEM_EPISODE_SIZE=7  # 7개 메시지를 하나의 에피소드로 그룹화
MEM_MAX_SHORT_TERM=50  # 단기 메모리 최대 메시지 수
MEM_LONG_TERM_SUMMARY_LENGTH=200  # 장기 메모리 요약 최대 길이

# Session Management
SESSION_TIMEOUT_MINUTES=60
SESSION_CLEANUP_INTERVAL_HOURS=24
MAX_SESSIONS_PER_USER=10

# =============================================================================
# CELERY CONFIGURATION (비동기 작업)
# =============================================================================

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND_URL=redis://redis:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=Asia/Seoul
CELERY_ENABLE_UTC=true

# Celery Task Settings
CELERY_TASK_SOFT_TIME_LIMIT=300  # 5분
CELERY_TASK_TIME_LIMIT=600  # 10분
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=1000

# =============================================================================
# WORKFLOW & AGENT CONFIGURATION
# =============================================================================

# LangGraph Settings
LANGGRAPH_CHECKPOINT_BACKEND=redis
LANGGRAPH_MAX_ITERATIONS=50
LANGGRAPH_TIMEOUT_SECONDS=300

# Agent Settings
AGENT_MAX_THINKING_TIME=30
AGENT_MAX_TOOL_CALLS=20
AGENT_TEMPERATURE=0.1
AGENT_MAX_TOKENS=4000

# Workflow Templates
WORKFLOW_TEMPLATES_PATH=./workflows
WORKFLOW_OFFICIAL_PATH=./workflows/official
WORKFLOW_CUSTOM_PATH=./workflows/custom

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment
ENVIRONMENT=development
DEBUG=true
TESTING=false

# API Settings
API_V1_PREFIX=/api/v1
API_TITLE=WSAP Backend API
API_DESCRIPTION=Workflow based Agentic AI Service Backend
API_VERSION=0.1.0

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE_PATH=
LOG_ROTATION_SIZE=10MB
LOG_RETENTION_DAYS=30

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
HEALTH_CHECK_INTERVAL=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Hot Reload
RELOAD=true
RELOAD_DIRS=["src"]

# Test Database (별도 테스트 DB 사용)
TEST_DATABASE_URL=

# Mock Services (개발환경)
USE_MOCK_LLM=false
USE_MOCK_EMBEDDING=false
USE_MOCK_SECRETS_MANAGER=true

# 테스트 환경 설정
ENVIRONMENT=
TEST_DATABASE_URL=